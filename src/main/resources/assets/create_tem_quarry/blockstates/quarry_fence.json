{
  "multipart": [
    {
      "apply": {
        "model": "create_tem_quarry:block/fence/post"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "create_tem_quarry:block/fence/side",
        "y": 0
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "create_tem_quarry:block/fence/side",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "create_tem_quarry:block/fence/side",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "create_tem_quarry:block/fence/side",
        "y": 270
      }
    }
  ]
}
